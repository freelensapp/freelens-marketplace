{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["extensions/.+/extension\\.yaml$"],
      "matchStrings": [
        "name:\\s*[\"'](?<packageName>[^\"']+)[\"']\\s+version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "{{packageName}}"
    }
  ],
  "packageRules": [
    { "matchDatasources": ["npm"], "groupName": "freelens-extensions" }
  ]
}
